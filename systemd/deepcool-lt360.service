[Unit]
Description=DeepCool LT360 VISION display daemon
After=default.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Packaged path (makepkg/AUR and other distro packages). install.sh installs a per-user copy of this
# unit into ~/.config/systemd/user/ with ExecStart pointing at its venv instead.
ExecStart=/usr/bin/lt360d --config %h/.config/deepcool-lt360/config.json
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
