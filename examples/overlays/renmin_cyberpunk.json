{
  "_comment": [
    "Renmin Cyberpunk: neon violet + cyan HUD. Bottom panel with CPU/GPU temps + load bars, big clock,",
    "and a custom shell sensor slot ('slot' below: any command that prints one line).",
    "Canvas 854x480. Colors: #RRGGBB or #RRGGBBAA (AA = alpha)."
  ],
  "custom_sensors": {
    "slot": {
      "_comment": "Change 'command' to anything: weather (curl wttr.in/?format=3), playerctl, a script...",
      "type": "command",
      "command": "uptime -p | sed 's/^up //'",
      "interval_sec": 30,
      "fallback": "--"
    }
  },
  "elements": [
    {"type": "rect", "x": 14, "y": 330, "w": 826, "h": 136, "fill": "#0a0518cc", "outline": "#a855f7", "radius": 16, "width": 2},
    {"type": "line", "x1": 36, "y1": 406, "x2": 818, "y2": 406, "color": "#22d3ee55", "width": 1},

    {"type": "text", "x": 36, "y": 338, "text": "CPU", "font": "light", "size": 18, "color": "#22d3ee"},
    {"type": "text", "x": 36, "y": 352, "text": "{cpu_temp}°{temp_unit}", "font": "semibold", "size": 44, "color": "#ffffff", "shadow": "#a855f7aa"},
    {"type": "bar", "x": 36, "y": 412, "w": 230, "h": 10, "source": "cpu_temp", "min": 30, "max": 95, "fill": "#a855f7", "bg": "#1a1625cc", "radius": 5},
    {"type": "text", "x": 36, "y": 430, "text": "LOAD {cpu_load}%", "font": "light", "size": 16, "color": "#c4b5fd"},

    {"type": "text", "x": 300, "y": 338, "text": "GPU", "font": "light", "size": 18, "color": "#22d3ee"},
    {"type": "text", "x": 300, "y": 352, "text": "{gpu_temp}°{temp_unit}", "font": "semibold", "size": 44, "color": "#ffffff", "shadow": "#22d3eeaa"},
    {"type": "bar", "x": 300, "y": 412, "w": 230, "h": 10, "source": "gpu_temp", "min": 30, "max": 95, "fill": "#22d3ee", "bg": "#1a1625cc", "radius": 5},
    {"type": "text", "x": 300, "y": 430, "text": "LOAD {gpu_load}%", "font": "light", "size": 16, "color": "#a5f3fc"},

    {"type": "text", "x": 824, "y": 338, "text": "{time}", "font": "pixel", "size": 40, "color": "#facc15", "align": "right", "shadow": "#000000aa"},
    {"type": "text", "x": 824, "y": 388, "text": "{date}", "font": "light", "size": 18, "color": "#c4b5fd", "align": "right"},
    {"type": "text", "x": 824, "y": 430, "text": "UP {slot}", "font": "light", "size": 16, "color": "#22d3ee", "align": "right", "max_width": 260}
  ]
}
