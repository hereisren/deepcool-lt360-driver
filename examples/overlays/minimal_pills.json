    {"type": "text", "x": 753, "y": 22, "text": "GPU {gpu_temp}°", "font": "semibold", "size": 28, "color": "#ffffff", "align": "center"},

    {"type": "rect", "x": 16, "y": 416, "w": 170, "h": 48, "fill": "#000000a0", "outline": "#facc15", "radius": 24, "width": 2},
    {"type": "text", "x": 101, "y": 422, "text": "RAM {ram_percent}%", "font": "semibold", "size": 28, "color": "#ffffff", "align": "center"},

