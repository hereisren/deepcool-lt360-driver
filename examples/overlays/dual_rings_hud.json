{
  "_comment": [
    "Dual Rings HUD: neon violet (CPU) and cyan (GPU) arc gauges with load sub-rings, over a bottom telemetry bar.",
    "Ring: x/y = top-left of the gauge box, radius, thickness, source, min/max, start_angle/end_angle",
    "(clockwise from 3 o'clock; 135 -> 405 is a 270-degree gauge), bg, fill, glow, and a centered text + label.",
    "Canvas 854x480 (elements) / 480x854 (elements_vertical)."
  ],
  "elements": [
    {"type": "ring", "x": 34, "y": 34, "radius": 104, "thickness": 16, "source": "cpu_temp", "min": 30, "max": 95, "bg": "#1a1625cc", "fill": "#a855f7", "glow": "#a855f7cc", "text": "{cpu_temp}°", "size": 54, "shadow": "#000000aa", "label": "CPU TEMP", "label_size": 15, "label_color": "#c4b5fd"},
    {"type": "ring", "x": 72, "y": 72, "radius": 66, "thickness": 6, "source": "cpu_load", "min": 0, "max": 100, "bg": "#1a162599", "fill": "#e9d5ff"},
    {"type": "text", "x": 138, "y": 212, "text": "LOAD {cpu_load}%", "font": "light", "size": 16, "color": "#e9d5ff", "align": "center", "shadow": "#000000aa"},

    {"type": "ring", "x": 612, "y": 34, "radius": 104, "thickness": 16, "source": "gpu_temp", "min": 30, "max": 95, "bg": "#1a1625cc", "fill": "#22d3ee", "glow": "#22d3eecc", "text": "{gpu_temp}°", "size": 54, "shadow": "#000000aa", "label": "GPU TEMP", "label_size": 15, "label_color": "#a5f3fc"},
    {"type": "ring", "x": 650, "y": 72, "radius": 66, "thickness": 6, "source": "gpu_load", "min": 0, "max": 100, "bg": "#1a162599", "fill": "#cffafe"},
