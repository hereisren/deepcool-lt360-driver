    {"type": "text", "x": 300, "y": 410, "text": "CPU CLOCK", "font": "light", "size": 15, "color": "#c4b5fd"},
    {"type": "text", "x": 300, "y": 428, "text": "{cpu_freq_ghz} GHz", "font": "semibold", "size": 26, "color": "#ffffff"},
    {"type": "text", "x": 520, "y": 410, "text": "GPU POWER", "font": "light", "size": 15, "color": "#a5f3fc"},
    {"type": "text", "x": 520, "y": 428, "text": "{gpu_power} W", "font": "semibold", "size": 26, "color": "#ffffff"},
    {"type": "text", "x": 826, "y": 414, "text": "{time}", "font": "pixel", "size": 40, "color": "#facc15", "align": "right", "shadow": "#000000aa"}
