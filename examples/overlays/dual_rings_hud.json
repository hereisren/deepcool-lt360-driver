    {"type": "text", "x": 28, "y": 796, "text": "RAM {ram_percent}%", "font": "light", "size": 18, "color": "#c4b5fd"},
    {"type": "text", "x": 452, "y": 792, "text": "{time}", "font": "pixel", "size": 36, "color": "#facc15", "align": "right", "shadow": "#000000aa"}
