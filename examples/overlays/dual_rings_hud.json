    {"type": "rect", "x": 0, "y": 396, "w": 854, "h": 84, "fill": "#0a0518d9"},
    {"type": "line", "x1": 0, "y1": 396, "x2": 427, "y2": 396, "color": "#a855f7", "width": 3},
    {"type": "line", "x1": 427, "y1": 396, "x2": 854, "y2": 396, "color": "#22d3ee", "width": 3},
    {"type": "text", "x": 28, "y": 410, "text": "RAM", "font": "light", "size": 15, "color": "#c4b5fd"},
